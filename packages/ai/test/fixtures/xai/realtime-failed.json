{
	"source": "Built by hand from xAI's documentation on 2026-10-29: the Voice API reference's Speech to text - Streaming (\"error - An error occurred during the session. Most errors (pipeline failures, stream timeouts, undecodable audio frames) close the connection\") and the Speech to Text guide's error event with its message; a failure of xAI's pipeline cannot be asked of the live API.",
	"recordable": false,
	"kind": "realtime-transcription",
	"request": {
		"type": "transcription",
		"audio": {
			"input": {
				"transcription": {
					"model": "xai/grok-voice-transcribe-2.0"
				}
			}
		}
	},
	"events": [
		{
			"type": "input_audio_buffer.append",
			"audio": ""
		}
	],
	"sockets": [
		{
			"url": "wss://api.x.ai/v1/stt?model=grok-voice-transcribe-2.0&encoding=pcm&sample_rate=24000&interim_results=true",
			"steps": [
				{
					"server": {
						"type": "transcript.created"
					}
				},
				{
					"client": {
						"base64": ""
					}
				},
				{
					"server": {
						"type": "error",
						"message": "The transcription pipeline failed"
					}
				},
				{
					"close": "server"
				}
			]
		}
	]
}
