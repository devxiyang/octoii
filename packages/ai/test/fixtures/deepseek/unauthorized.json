{
	"source": "Built by hand from DeepSeek's API documentation on 2026-10-29: its error codes page and the Responses API guide; the wording of the message and the body in OpenAI's form are a sample. A failure the live API cannot be asked for is not recorded.",
	"recordable": false,
	"request": {
		"model": "deepseek/deepseek-flash",
		"input": "Hello"
	},
	"exchanges": [
		{
			"request": {
				"method": "POST",
				"url": "https://api.deepseek.com/responses",
				"body": {
					"model": "deepseek-flash",
					"input": "Hello",
					"stream": true
				}
			},
			"response": {
				"status": 401,
				"headers": {
					"content-type": "application/json"
				},
				"chunks": [
					"{\"error\":{\"message\":\"Authentication Fails, Your api key: ****0000 is invalid\",\"type\":\"authentication_error\",\"param\":null,\"code\":\"invalid_request_error\"}}"
				]
			}
		}
	]
}
